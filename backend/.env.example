# Server Configuration
PORT=5000
NODE_ENV=development

# Client / CORS Configuration
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# MongoDB Atlas Configuration (Phase 2B)
# Replace placeholders with your actual MongoDB Atlas cluster credentials and database name
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/<db_name>?retryWrites=true&w=majority
DATABASE_NAME=genai_lab_learning_db

# Authentication & JWT Configuration (Phase 3B)
# Secret keys must be at least 32 characters in production environments
JWT_SECRET=your_minimum_32_character_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_minimum_32_character_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=genai-lab-learning-framework
JWT_AUDIENCE=genai-lab-client

# SMTP Email Configuration (Nodemailer)
# Configure these variables to dispatch live activation and password reset emails to users.
# Supported providers include Gmail (with App Password), SendGrid, Amazon SES, Mailgun, Brevo, or custom SMTP.
# If these variables are left unconfigured, the platform will safely report EMAIL_SERVICE_UNCONFIGURED without crashing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_or_smtp_key
EMAIL_FROM="GenAI Laboratory Learning" <noreply@genai-lab-learning.edu>
